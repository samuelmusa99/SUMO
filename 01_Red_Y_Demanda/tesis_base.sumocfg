<?xml version="1.0" encoding="UTF-8"?>
<!-- Propuesta Estanga y Savignani (2021), hora pico 2026: distribuidor tipo puente en Camino Real y avenida en proyeccion
     (30 % de los viajes FFAA sur por Camino Real). Misma demanda base 2026 (herramientas/demanda_propuesta.py).
     Tiempo: 0-900 s calentamiento, 900-4500 s hora de analisis, despues se vacia la red. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="costanera.net.xml"/>
        <route-files value="costanera.rou.xml,demanda/demanda_savignani_2026.rou.xml"/>
        <additional-files value="mapa_fondo.poly.xml,medidores.add.xml,vista.xml,paradas.add.xml,detectores_intersecciones.add.xml,distribuidor.add.xml"/>
    </input>

    <gui_only>
        <gui-settings-file value="vista.xml"/>
    </gui_only>

    <output>
        <tripinfo-output value="../02_Resultados_Base/reporte_viajes.xml"/>
        <queue-output value="../02_Resultados_Base/reporte_colas.xml"/>
        <statistic-output value="../02_Resultados_Base/estadisticas.xml"/>
        <!-- tambien se registran los vehiculos que siguen en la red al final (atrapados), no solo los que llegaron -->
        <tripinfo-output.write-unfinished value="true"/>
    </output>

    <processing>
        <!-- sin teletransportes: un vehiculo que espera mucho sigue esperando (como en la realidad), no se saca de la red -->
        <time-to-teleport value="-1"/>
    </processing>

    <time>
        <begin value="0"/>
        <end value="5400"/>
    </time>
</sumoConfiguration>
