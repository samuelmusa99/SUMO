<?xml version="1.0" encoding="UTF-8"?>
<!-- Propuesta Assouad y Peroza (2022), hora pico 2041: puente sobre FFAA en Perrokero (rampas de 40 m al 15 %, tablero de 20 m,
     1 carril por sentido, solo livianos) y semaforo de 120 s a nivel. Misma demanda base 2041 (herramientas/demanda_propuesta.py).
     Tiempo: 0-900 s calentamiento, 900-4500 s hora de analisis, despues se vacia la red. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="costanera.net.xml"/>
        <route-files value="costanera.rou.xml,demanda/demanda_perozo_2041.rou.xml"/>
        <additional-files value="mapa_fondo.poly.xml,medidores_2041.add.xml,vista.xml,paradas.add.xml,detectores_intersecciones_2041.add.xml,distribuidor.add.xml"/>
    </input>

    <gui_only>
        <gui-settings-file value="vista.xml"/>
    </gui_only>

    <output>
        <tripinfo-output value="../02_Resultados_2041/reporte_viajes.xml"/>
        <queue-output value="../02_Resultados_2041/reporte_colas.xml"/>
        <statistic-output value="../02_Resultados_2041/estadisticas.xml"/>
        <!-- tambien se registran los vehiculos que siguen en la red al final (atrapados), no solo los que llegaron -->
        <tripinfo-output.write-unfinished value="true"/>
    </output>

    <processing>
        <!-- sin teletransportes: un vehiculo que espera mucho sigue esperando (como en la realidad), no se saca de la red -->
        <time-to-teleport value="-1"/>
    </processing>

    <time>
        <begin value="0"/>
        <end value="5400"/>
    </time>
</sumoConfiguration>
