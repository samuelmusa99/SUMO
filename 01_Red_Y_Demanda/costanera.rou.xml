<?xml version="1.0" encoding="UTF-8"?>

<!-- Tipos de vehiculo y transporte publico con paradas (comun a todos los escenarios).
     La demanda general de cada escenario esta en demanda/demanda_<escenario>.rou.xml,
     generada con herramientas/generar_demanda.py a partir de demanda/conteos_movimientos.csv.
     Los volumenes de esta hoja se descuentan automaticamente de los conteos. -->

<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Tipos de vehiculo (revisados 2026-10-16 para eliminar choques y comportamientos irreales):
         - sin jmIgnoreFoeProb: ningun vehiculo ignora al que tiene prioridad (antes se atravesaban en las intersecciones)
         - pesado: aceleracion 1,0 m/s2 (antes 0,4; SUMO usa 1,2 para buses), prefiere el carril derecho y casi no cambia de carril para adelantar
         - se mantiene el comportamiento local: impaciencia y paso con amarillo (jmDriveAfterYellowTime)
         - livianos y carritos circulan en promedio 10 % sobre el limite (40 -> 44 km/h): velocidad de circulacion de 40-50 km/h observada por Perozo (2022) y Savignani (2021) -->
<vType id="liviano" length="5.00" minGap="1.50" maxSpeed="22.22" speedFactor="norm(1.10,0.10)" vClass="passenger" guiShape="passenger" color="blue" width="1.85"
       accel="2.6" decel="4.5" emergencyDecel="9.0" sigma="0.5" tau="1.0" impatience="0.50"
       laneChangeModel="LC2013" lcStrategic="1.0" lcCooperative="0.5" lcSpeedGain="1.5" lcKeepRight="1.0" lcAssertive="1.3"
       jmDriveAfterYellowTime="2.0"/>

<vType id="pesado" length="12.00" minGap="2.50" maxSpeed="13.89" speedFactor="norm(0.85,0.05)" vClass="bus" guiShape="bus" color="red" width="2.50"
       accel="1.0" decel="3.5" emergencyDecel="7.0" sigma="0.5" tau="1.2" impatience="0.10"
       laneChangeModel="LC2013" lcStrategic="1.0" lcCooperative="1.0" lcSpeedGain="0.1" lcKeepRight="5.0" lcAssertive="0.8"
       jmDriveAfterYellowTime="1.0"/>

<vType id="carrito" length="5.00" minGap="1.00" maxSpeed="19.44" speedFactor="norm(1.10,0.12)" vClass="bus" guiShape="passenger" color="yellow" width="1.85"
       accel="2.8" decel="4.5" emergencyDecel="9.0" sigma="0.6" tau="1.0" impatience="0.80"
       laneChangeModel="LC2013" lcStrategic="1.5" lcCooperative="0.5" lcSpeedGain="3.0" lcKeepRight="0.5" lcAssertive="1.5"
       jmDriveAfterYellowTime="2.0"/>

    <!-- Transporte publico con paradas: buses (pesado) y carritos/por puestos (carrito) -->
    <flow id="ffaa_lech_P" type="pesado" begin="0.00" end="4500.00" departLane="0" departSpeed="max" perHour="33.00" from="fuerzas_armadas_salida" to="lecheria_entrada"> <stop busStop="bs_0" duration="30.00"/> </flow>
    <flow id="ffaa_lech_C" type="carrito" begin="0.00" end="4500.00" departLane="best" departSpeed="max" perHour="33.00" from="fuerzas_armadas_salida" to="lecheria_entrada"> <stop busStop="bs_0" duration="15.00"/> </flow>
    <flow id="lech_cost_P" type="pesado" begin="0.00" end="4500.00" departLane="0" departSpeed="max" perHour="40.00" from="lecheria_salida" to="costanera_entrada"> <stop busStop="bs_1" duration="30.00"/> </flow>
    <flow id="lech_cost_C" type="carrito" begin="0.00" end="4500.00" departLane="best" departSpeed="max" perHour="40.00" from="lecheria_salida" to="costanera_entrada"> <stop busStop="bs_1" duration="15.00"/> </flow>
</routes>
